# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key only. Never put a secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# PostHog analytics (optional; leave unset to turn analytics off).
# Project API key: PostHog -> Project settings. It is a public key, safe in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud is the default. For EU cloud use https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

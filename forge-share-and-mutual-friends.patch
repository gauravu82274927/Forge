diff --git a/supabase/add_mutual_friends.sql b/supabase/add_mutual_friends.sql
new file mode 100644
index 0000000..bb4024a
--- /dev/null
+++ b/supabase/add_mutual_friends.sql
@@ -0,0 +1,28 @@
+/*
+# Mutual friends
+
+Adds `mutual_friends(other_id)`: returns the ids of people who are accepted
+friends of both the caller and `other_id`. Runs as SECURITY DEFINER because
+RLS on `friendships` only lets people see their own rows, and returns ids only.
+*/
+
+CREATE OR REPLACE FUNCTION public.mutual_friends(other_id uuid)
+RETURNS SETOF uuid
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public AS $$
+  WITH mine AS (
+    SELECT CASE WHEN requester_id = auth.uid() THEN addressee_id ELSE requester_id END AS fid
+    FROM public.friendships
+    WHERE status = 'accepted' AND (requester_id = auth.uid() OR addressee_id = auth.uid())
+  ),
+  theirs AS (
+    SELECT CASE WHEN requester_id = other_id THEN addressee_id ELSE requester_id END AS fid
+    FROM public.friendships
+    WHERE status = 'accepted' AND (requester_id = other_id OR addressee_id = other_id)
+  )
+  SELECT fid FROM mine INTERSECT SELECT fid FROM theirs;
+$$;
+
+REVOKE ALL ON FUNCTION public.mutual_friends(uuid) FROM anon, public;
+GRANT EXECUTE ON FUNCTION public.mutual_friends(uuid) TO authenticated;
+
+NOTIFY pgrst, 'reload schema';

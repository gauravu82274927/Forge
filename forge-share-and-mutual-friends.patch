+/** Members who are accepted friends of both the signed-in user and `otherId`. */
+export async function fetchMutualFriends(otherId: string): Promise<PersonResult[]> {
+  const { data: ids, error } = await supabase.rpc('mutual_friends', { other_id: otherId });
+  if (error) throw new Error(error.message);
+  const list = (ids ?? []) as unknown as string[];
+  if (list.length === 0) return [];
+  const { data, error: pErr } = await supabase
+    .from('profiles')
+    .select('id, display_name, college, course, skills, experience_level, avatar_url')
+    .in('id', list);
+  if (pErr) throw new Error(pErr.message);
+  return (data ?? []) as unknown as PersonResult[];
+}
